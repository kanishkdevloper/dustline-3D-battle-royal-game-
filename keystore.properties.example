# Copy this file to  keystore.properties  (it is git-ignored) and fill in YOUR values. Never commit the real file or the .jks.
# Put dustline-upload.jks next to this file (project root).
storeFile=dustline-upload.jks
storePassword=PUT_YOUR_KEYSTORE_PASSWORD_HERE
keyAlias=dustline
